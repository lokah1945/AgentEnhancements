      },
      "description": "GitHub API access via MCP \u00e2\u20ac\u201d repos, issues, PRs, actions",
      "tools": [
        "health",
        "get_repo",
        "list_issues",
        "create_issue",
        "create_pr",
        "list_prs",
        "get_file",
        "search_code"
      ],
      "status": "planned",
      "id": "github-mcp"
    },
