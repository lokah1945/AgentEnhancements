  },
  "preflight": {
    "mode": 0,
    "sdk": "",
    "endpoint": "",
    "model": "",
    "api_key_ref": "PREFLIGHT_API_KEY"
  },
  "_preflight_mode1_example": {
    "mode": 1,
    "sdk": "openai",
    "endpoint": "https://openrouter.ai/api/v1",
    "model": "openai/gpt-4o-mini",
    "api_key_ref": "PREFLIGHT_API_KEY"
  },
  "_preflight_mode1_note": "Mode 1 is the custom endpoint selector (previously labelled Mode 2). Host-native selection was removed in AE-003. Configure mode 0 or 1; mode 2 is rejected.",
