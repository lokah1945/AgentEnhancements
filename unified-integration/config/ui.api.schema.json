{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui.api.schema.json",
  "type": "object",
  "required": [
    "version",
    "api_keys",
    "connections",
    "mcp"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "api_keys": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "connections": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "required": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optional": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
