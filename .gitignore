# Agent-specific local settings (machine-specific, never commit)
.claude/settings.local.json
.claude/*.tmp.*
.claude/settings.local.json.tmp.*

# Editor / OS junk
*.bak
*.tmp
*.tmp.*
*.swp
.DS_Store

# Aggregation temp files (unified-integration/skills)
unified-integration/skills/.skills-meta.tmp
unified-integration/skills/all-skills.json.tmp

# Generated skill registry trees: populated by setup.sh at install time
# (see docs/audit/AUDIT_REPORT.md F-28). The committed flat samples in
# by-category/general/ stay tracked; everything generated is ignored.
unified-integration/skills/by-agent/
unified-integration/skills/by-category/*
!unified-integration/skills/by-category/general/
unified-integration/skills/by-category/general/*
!unified-integration/skills/by-category/general/*.md

# Config backups created by setup.sh merges
*.backup.*

# Python bytecode
__pycache__/
*.pyc
