{
  "_comment": "Canonical native gateway template. setup.sh renders the repository path and isolated Python interpreter for all three CLIs. Credentials are read live from ui.api.json; empty-key cloud tools and unconfigured external servers are hidden. Nine bundled implementations are loaded internally by the gateway.",
  "mcpServers": {
    "agent-enhancements": {
      "command": "python3",
      "args": ["PLACEHOLDER_REPO_ROOT/unified-integration/mcp-servers/gateway.py"],
      "env": {}
    }
  }
}
