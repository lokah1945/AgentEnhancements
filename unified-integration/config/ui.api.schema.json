{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui.api.schema.json",
  "type": "object",
  "required": [
    "version",
    "api_keys",
    "connections",
    "mcp"
  ],
  "properties": {
    "version": {
      "enum": [
        1,
        2
      ],
      "description": "2 is current; 1 (string credentials) is accepted until `api_config.py migrate` upgrades the file."
    },
    "api_keys": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string"
            }
          },
          {
            "type": "string",
            "description": "version 1 only"
          }
        ]
      }
    },
    "connections": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "required": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optional": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "any_of": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "At least one reference must hold a usable key."
          }
        },
        "additionalProperties": true
      }
    },
    "preflight": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "sdk": {
          "type": "string",
          "description": "openai or anthropic (Mode 2)"
        },
        "endpoint": {
          "type": "string",
          "description": "HTTPS origin/path without credentials (Mode 2)"
        },
        "model": {
          "type": "string"
        },
        "api_key_ref": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
